# === InsightKit — Docker deployment ===
# Copy ke .env, isi sesuai perusahaan kamu. JANGAN commit .env ke git.

# ---------- Database (WAJIB) ----------
# Pakai user READ-ONLY khusus (bukan admin). Contoh:
#   PostgreSQL: postgresql+psycopg://insightkit_ro:RAHASIA@db.internal:5432/nama_db
#   MySQL:      mysql+asyncmy://insightkit_ro:RAHASIA@db.internal:3306/nama_db
#   SQLite:     sqlite+aiosqlite:////data/demo.db
INSIGHTKIT_DATABASE__URL=postgresql+psycopg://insightkit_ro:RAHASIA@db.internal:5432/nama_db

# ---------- LLM — pilih SALAH SATU ----------
# Opsi A: LLM self-host (service ollama di docker-compose.yml)
INSIGHTKIT_LLM__BASE_URL=http://ollama:11434/v1
INSIGHTKIT_LLM__API_KEY=ollama
INSIGHTKIT_LLM__MODEL=qwen2.5-coder
# Opsi B: cloud OpenAI-compatible (DeepSeek / OpenAI / Gemini dll)
# INSIGHTKIT_LLM__BASE_URL=https://api.deepseek.com/v1
# INSIGHTKIT_LLM__API_KEY=sk-xxxxxxxx
# INSIGHTKIT_LLM__MODEL=deepseek-chat
# Opsi C: vLLM internal perusahaan (server GPU sendiri)
# INSIGHTKIT_LLM__BASE_URL=http://vllm.internal:8000/v1
# INSIGHTKIT_LLM__API_KEY=EMPTY

# ---------- Keamanan (WAJIB ganti) ----------
# Generate: openssl rand -hex 32
INSIGHTKIT_API__JWT_SECRET=GANTI_DENGAN_RANDOM_64_KARAKTER_HEX
INSIGHTKIT_SECURITY__ROW_LIMIT=10000
INSIGHTKIT_SECURITY__QUERY_TIMEOUT_S=30
# Tabel yang diblokir total:
INSIGHTKIT_SECURITY__FORBIDDEN_TABLES=["salaries","raw_logs","user_credentials"]

# ---------- Semantic layer (opsional) ----------
# INSIGHTKIT_SEMANTIC_PATH=/config/semantic.yml

# ---------- Lainnya ----------
INSIGHTKIT_INSIGHT__LANGUAGE=id          # en | id
INSIGHTKIT_CACHE__TTL_S=300
INSIGHTKIT_API__RATE_LIMIT_PER_MIN=60
